# TravelFlow CMS - Plantilla de entorno para Testing automatizado
APP_ENV=testing
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4
CACHE_STORE=array

# Configuración obligatoria MySQL para pruebas
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tf_cms_test
DB_USERNAME=root
DB_PASSWORD=

MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
